# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pms_db
DB_USER=root
DB_PASSWORD=lokesh

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=1h
REFRESH_TOKEN_EXPIRE=7d

# Server
NODE_ENV=development
API_PORT=5000

# LDAP / Auth
USE_MOCK_LDAP=true
LDAP_URL=ldap://ldap.cutm.ac.in:389
LDAP_BIND_DN=cn=admin,dc=cutm,dc=ac,dc=in
LDAP_BIND_PASSWORD=your-ldap-password
LDAP_USER_BASE=ou=users,dc=cutm,dc=ac,dc=in

# Google OAuth (optional - required for Google Sign-In feature)
# Get these from: https://console.cloud.google.com/
# Only users with @cutm.ac.in and @cutmap.ac.in emails are allowed
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# File Storage
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=50MB

# Timesheet Sync
MOCK_INTERN_API_URL=http://localhost:5001
INTERN_API_SYNC_INTERVAL=300000
TIMESHEET_SYNC_RETRY_ATTEMPTS=3

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=debug
