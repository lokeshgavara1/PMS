# ============================================================================
# CUTM-PMS BACKEND ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=production
API_PORT=5000

# ============================================================================
# DATABASE CONFIGURATION (MySQL 8.0+)
# ============================================================================
# Connection string: mysql://user:password@host:port/database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pms_db
DB_USER=pms_user
DB_PASSWORD=your_secure_database_password_here

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRE=24h
REFRESH_TOKEN_SECRET=your_long_random_refresh_token_secret_here
REFRESH_TOKEN_EXPIRE=7d

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================
# Frontend origin URL - must match frontend deployment URL
CORS_ORIGIN=https://pms.cutm.ac.in

# ============================================================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ============================================================================
# Get these from: https://console.cloud.google.com/
# 1. Create OAuth 2.0 Client ID for Web Application
# 2. Add Authorized JavaScript Origins: https://pms.cutm.ac.in
# 3. Add Authorized Redirect URIs: https://pms.cutm.ac.in/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================================
# LDAP CONFIGURATION (Optional - for future CUTM LDAP integration)
# ============================================================================
LDAP_SERVER=ldap://your-ldap-server.cutm.ac.in
LDAP_PORT=389
LDAP_DN=cn=admin,dc=cutm,dc=ac,dc=in
LDAP_PASSWORD=your_ldap_admin_password

# ============================================================================
# EMAIL CONFIGURATION (For notifications)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@cutm.ac.in
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=noreply@cutm.ac.in

# ============================================================================
# FILE STORAGE CONFIGURATION
# ============================================================================
STORAGE_TYPE=local
STORAGE_PATH=/var/pms/uploads
MAX_FILE_SIZE=26214400

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FILE=/var/log/pms/app.log

# ============================================================================
# ALLOWED EMAIL DOMAINS
# ============================================================================
ALLOWED_DOMAINS=cutm.ac.in,cutmap.ac.in,thegttech.com,esse.co.in,ftl.org.in

# ============================================================================
# SESSION CONFIGURATION
# ============================================================================
SESSION_SECRET=your_session_secret_key_here
SESSION_TIMEOUT=1800

# ============================================================================
# MONITORING
# ============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ENABLE_METRICS=true
